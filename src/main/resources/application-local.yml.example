# Copy this file to `application-local.yml` and fill in your Neon connection details.
# `application-local.yml` is git-ignored.
#
# In Neon dashboard → Connection Details → copy:
#   host:     ep-xxxxx-pooler.ap-southeast-1.aws.neon.tech   (pooled connection)
#   database: neondb
#   user:     neondb_owner
#   password: <shown after clicking "Show password">

spring:
  datasource:
    url: jdbc:postgresql://<HOST>/neondb?sslmode=require
    username: neondb_owner
    password: <PASSWORD>
